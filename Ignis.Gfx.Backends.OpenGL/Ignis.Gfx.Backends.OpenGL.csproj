<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Allow samples project access to internal members for debugging/testing -->
    <ItemGroup>
        <InternalsVisibleTo Include="Ignis.Gfx.Samples"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0"/>
        <PackageReference Include="Silk.NET.Windowing" Version="2.22.0"/>
        <PackageReference Include="Silk.NET.Input" Version="2.22.0"/>
        <!-- Cross-platform native windowing backend (GLFW works on Windows, Linux, macOS) -->
        <PackageReference Include="Silk.NET.GLFW" Version="2.22.0"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ignis.Gfx\Ignis.Gfx.csproj"/>
    </ItemGroup>

</Project>
